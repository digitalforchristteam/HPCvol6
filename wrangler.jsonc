{
  "name": "servetogether",
  "main": "worker.js",
  "compatibility_date": "2026-10-26",
  "assets": { "directory": "./", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "church-volunteers" }],
  "triggers": { "crons": ["*/15 * * * *"] }
}
